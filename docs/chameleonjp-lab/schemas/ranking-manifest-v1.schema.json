{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "カメレオンJP ランキング連携マニフェスト v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "game_id",
    "title",
    "description",
    "share_text",
    "canonical_url",
    "release_date",
    "client_version",
    "submission_mode",
    "lab",
    "player_name",
    "play_count",
    "submission",
    "ranking_entries"
  ],
  "properties": {
    "schema_version": {
      "const": "chameleonjp-ranking-manifest-v1"
    },
    "game_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "share_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "canonical_url": {
      "type": "string",
      "pattern": "^https://[^?# ]+/$"
    },
    "release_date": {
      "type": "string"
    },
    "client_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "submission_mode": {
      "enum": [
        "shared",
        "verified"
      ]
    },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representative_slug"
      ],
      "properties": {
        "representative_slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]{0,79}$"
        }
      }
    },
    "player_name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_before_start",
        "min_length",
        "max_length",
        "storage_key"
      ],
      "properties": {
        "required_before_start": {
          "type": "boolean"
        },
        "min_length": {
          "const": 1
        },
        "max_length": {
          "enum": [20, 24]
        },
        "storage_key": {
          "type": "string",
          "minLength": 1
        },
        "required_for_ranking": {
          "const": true
        }
      }
    },
    "play_count": {
      "$ref": "#/$defs/play_count"
    },
    "submission": {
      "$ref": "#/$defs/submission"
    },
    "ranking_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode_id",
          "game_slug",
          "title",
          "display_order",
          "top_ranking_type",
          "score_order",
          "score_unit",
          "score_scale",
          "score_decimals",
          "score_label",
          "first_score_label",
          "best_score_label",
          "score_min",
          "score_max",
          "ranked_results"
        ],
        "properties": {
          "mode_id": {
            "type": "string",
            "minLength": 1
          },
          "game_slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]{0,79}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "display_order": {
            "type": "integer",
            "minimum": 1
          },
          "top_ranking_type": {
            "enum": [
              "first",
              "best"
            ]
          },
          "score_order": {
            "enum": [
              "asc",
              "desc"
            ]
          },
          "score_unit": {
            "type": "string",
            "minLength": 1
          },
          "score_scale": {
            "type": "integer",
            "minimum": 1
          },
          "score_decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "score_label": {
            "type": "string",
            "minLength": 1
          },
          "first_score_label": {
            "type": "string",
            "minLength": 1
          },
          "best_score_label": {
            "type": "string",
            "minLength": 1
          },
          "score_min": {
            "type": "integer"
          },
          "score_max": {
            "type": "integer"
          },
          "ranked_results": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "play_count": {
            "$ref": "#/$defs/play_count"
          },
          "submission": {
            "$ref": "#/$defs/submission"
          },
          "ranking_rpc": {
            "$ref": "#/$defs/endpoint"
          },
          "stats_rpc": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "dependentRequired": {
          "play_count": [
            "submission",
            "ranking_rpc",
            "stats_rpc"
          ],
          "submission": [
            "play_count",
            "ranking_rpc",
            "stats_rpc"
          ],
          "ranking_rpc": [
            "play_count",
            "submission",
            "stats_rpc"
          ],
          "stats_rpc": [
            "play_count",
            "submission",
            "ranking_rpc"
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode_id": {
                  "const": "chameleol_time_attack"
                }
              },
              "required": [
                "mode_id"
              ]
            },
            "then": {
              "required": [
                "play_count",
                "submission",
                "ranking_rpc",
                "stats_rpc"
              ],
              "properties": {
                "game_slug": {
                  "const": "chameleol"
                },
                "ranking_rpc": {
                  "const": "kamereoru/time-attack-ranking"
                },
                "stats_rpc": {
                  "const": "kamereoru/time-attack-stats"
                },
                "play_count": {
                  "properties": {
                    "rpc": {
                      "const": "kamereoru/time-attack-launch"
                    }
                  },
                  "not": {
                    "required": [
                      "unregistered_rpc"
                    ]
                  }
                },
                "submission": {
                  "properties": {
                    "rpc": {
                      "const": "kamereoru/time-attack-complete"
                    },
                    "timeout_ms": {
                      "const": 8000
                    }
                  }
                },
                "top_ranking_type": {
                  "const": "best"
                },
                "score_order": {
                  "const": "asc"
                },
                "score_unit": {
                  "const": "秒"
                },
                "score_scale": {
                  "const": 100
                },
                "score_decimals": {
                  "const": 2
                },
                "score_min": {
                  "const": 1500
                },
                "score_max": {
                  "const": 900719925468300
                },
                "ranked_results": {
                  "const": [
                    "cleared"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "player_name": { "properties": { "max_length": { "const": 24 } } }
        }
      },
      "then": { "properties": { "game_id": { "const": "junglegym_onigokko" } } }
    },
    {
      "if": {
        "properties": {
          "game_id": {
            "const": "faitofuraito"
          }
        },
        "required": [
          "game_id"
        ]
      },
      "then": {
        "properties": {
          "player_name": {
            "required": [
              "required_for_ranking"
            ],
            "properties": {
              "required_before_start": {
                "const": false
              },
              "required_for_ranking": {
                "const": true
              }
            }
          },
          "play_count": {
            "required": [
              "unregistered_rpc"
            ],
            "properties": {
              "rpc": {
                "const": "start_game_play_v1"
              },
              "unregistered_rpc": {
                "const": "start_faitofuraito_guest_play_v1"
              }
            }
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "game_id": {
              "const": "chameleol"
            }
          }
        },
        "then": {
          "properties": {
            "submission_mode": {
              "const": "verified"
            },
            "player_name": {
              "required": [
                "required_for_ranking"
              ],
              "properties": {
                "required_before_start": {
                  "const": false
                },
                "required_for_ranking": {
                  "const": true
                }
              }
            },
            "play_count": {
              "properties": {
                "rpc": {
                  "const": "kamereoru/launch"
                }
              },
              "not": {
                "required": [
                  "unregistered_rpc"
                ]
              }
            },
            "submission": {
              "properties": {
                "rpc": {
                  "const": "kamereoru/complete"
                }
              }
            }
          }
        },
        "else": {
          "if": {
            "properties": {
              "game_id": {
                "const": "junglegym_onigokko"
              }
            }
          },
          "then": {
            "properties": {
              "submission_mode": {
                "const": "verified"
              },
              "player_name": {
                "required": [
                  "required_for_ranking"
                ],
                "properties": {
                    "max_length": { "const": 24 },
                  "required_before_start": {
                    "const": false
                  },
                  "required_for_ranking": {
                    "const": true
                  }
                }
              },
              "play_count": {
                "properties": {
                  "rpc": {
                    "const": "junglegym_start_v1"
                  }
                }
              },
              "submission": {
                "properties": {
                  "rpc": {
                    "const": "junglegym_finish_v1"
                  }
                }
              }
            }
          },
          "else": {
            "if": {
              "properties": { "game_id": { "const": "medjedshin_ha_mamotteru" } }
            },
            "then": {
              "properties": {
                "submission_mode": { "const": "verified" },
                "player_name": {
                  "required": ["required_for_ranking"],
                  "properties": {
                    "required_before_start": { "const": false },
                    "required_for_ranking": { "const": true }
                  }
                },
                "play_count": {
                  "properties": { "rpc": { "const": "medjed_start_v1" } },
                  "not": { "required": ["unregistered_rpc"] }
                },
                "submission": {
                  "properties": { "rpc": { "const": "medjed_finish_v1" } }
                }
              }
            },
            "else": {
              "properties": {
                "player_name": {
                  "properties": {
                    "required_before_start": {
                      "const": true
                    }
                  },
                  "not": {
                    "required": [
                      "required_for_ranking"
                    ]
                  }
                },
                "play_count": {
                  "not": {
                    "required": [
                      "unregistered_rpc"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "submission_mode": {
              "const": "verified"
            }
          }
        }
      },
      "then": {
        "properties": {
          "ranking_entries": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "play_count"
                    ]
                  },
                  {
                    "required": [
                      "submission"
                    ]
                  },
                  {
                    "required": [
                      "ranking_rpc"
                    ]
                  },
                  {
                    "required": [
                      "stats_rpc"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ranking_entries": {
            "contains": {
              "properties": {
                "mode_id": {
                  "const": "chameleol_time_attack"
                }
              },
              "required": [
                "mode_id"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "game_id": {
            "const": "chameleol"
          }
        }
      }
    }
  ],
  "$defs": {
    "play_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count_at",
        "rpc",
        "idempotency"
      ],
      "properties": {
        "count_at": {
          "const": "start"
        },
        "rpc": {
          "type": "string",
          "minLength": 1
        },
        "idempotency": {
          "const": true
        },
        "unregistered_rpc": {
          "const": "start_faitofuraito_guest_play_v1"
        }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rpc",
        "automatic",
        "idempotency",
        "timeout_ms"
      ],
      "properties": {
        "rpc": {
          "type": "string",
          "minLength": 1
        },
        "automatic": {
          "const": true
        },
        "idempotency": {
          "const": true
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000
        }
      }
    },
    "endpoint": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+/[a-z0-9_-]+$"
    }
  }
}
